<?xml version="1.0" encoding="UTF-8"?>
<!--
  CPack WIX patch file for the `client` component MSI (TASK-148).

  WiX requires every Component to be referenced by some Feature or it is
  silently excluded from the installed tree. CPack's auto-generated
  features.wxs defines <FeatureRef Id="CM_C_client"> listing the client
  component's own binaries — this patch adds a <ComponentRef> for the
  register-client-task.ps1 component defined in client-extra.wxs (see its
  header comment) into that same FeatureRef, matched by Id.

  FRAGILITY NOTE: "CM_C_client" is CPack's auto-derived Feature id for the
  `client` CPack component (COMPONENT client in CMakeLists.txt's
  install()). If that CPack component name ever changes, this patch's
  target id changes too and it silently stops matching (verify the
  compiled MSI's Feature table still includes the task-script component
  after any such rename, the same caution as server-patch.xml's).
-->
<CPackWiXPatch>
  <CPackWiXFragment Id="CM_C_client">
    <ComponentRef Id="CM_C_ClientTaskScript" />
  </CPackWiXFragment>

  <!--
    TASK-247: tried and abandoned. Patching CPack's auto-generated
    per-binary Components to add an HKCU RegistryValue KeyPath (to satisfy
    ICE38 for this per-user, LocalAppDataFolder-rooted install) turned out
    to be impossible via CPACK_WIX_PATCH_FILE: a CPackWiXFragment can only
    ADD new child elements to the element it matches by Id, never modify
    or remove that element's own existing attributes. Confirmed
    empirically: CNDL0005 "unexpected child element 'Component'"/"File"
    when a patch fragment's own top-level element shared the matched
    element's tag name, and CNDL0042 "multiple key paths" once a
    RegistryValue KeyPath was added alongside the File's own
    already `KeyPath="yes"`, which nothing can flip off from a patch.
    Fixed instead via an explicit forced-cleanup custom action on
    uninstall (`RemoveClientInstallDir` in client-extra.wxs) rather than
    relying on MSI's native per-component file-removal tracking for these
    three Components; see that action's own comment for why suppressing
    ICE38/64/91 (in the cpack invocation, see docs/RELEASE.md) is safe
    given that cleanup: those ICEs are static-analysis lint, not something
    msiexec consults at actual install/uninstall time.
  -->
</CPackWiXPatch>
