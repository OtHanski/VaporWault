# vapourwault-web-gateway.service — HTTP/JSON gateway for the browser
# frontend (TASK-127/129/142). Sibling service to vapourwaultd.service, not
# a dependent of it: this process is its own vw/1 client against the
# VaporWault server (--server-host/--server-port below), which is very
# often a *different* host than the one running this gateway.
#
# This unit's ExecStart is the gateway's only configuration surface — there
# is no separate gateway config file, only the CLI flags documented by
# `vapourwault-web-gateway --help` (src/gateway/main.c). Edit the ExecStart
# line below for your deployment, then:
#   systemctl daemon-reload
#   systemctl restart vapourwault-web-gateway
#
# See docs/DEPLOYMENT.md's "Web gateway + nginx + frontend" section for the
# full install walkthrough. IMPORTANT: this listener (--listen-host/
# --listen-port) must NEVER be reachable directly from the internet — it
# trusts nginx as its sole upstream (TASK-129's vw_http scoping) and does
# not itself robustly handle malformed/non-HTTP1.1 traffic. Keep
# --listen-host at 127.0.0.1 (the gateway's own default too) unless nginx
# is reachable only via some other address this host doesn't expose
# publicly either.

[Unit]
Description=VaporWault web gateway (HTTP/JSON API for the browser frontend)
Documentation=https://github.com/vapourwault/vapourwault
After=network-online.target
Wants=network-online.target
# Deliberately NOT After=/Wants=vapourwaultd.service: the VaporWault server
# this gateway connects to is frequently a separate host. If yours happens
# to be the same host, add vapourwaultd.service to both lines above.

[Service]
Type=simple
ExecStart=/usr/local/bin/vapourwault-web-gateway --server-host 127.0.0.1 --server-port 4430 --ca-cert /etc/vapourwault/server.crt --listen-host 127.0.0.1 --listen-port 8080 --state-dir /var/lib/vapourwault-gateway
Restart=on-failure
RestartSec=5s

User=vapourwault
Group=vapourwault

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# TASK-165: --state-dir enables persistent "remember me" (a small
# remember.db file, self-hardened to 0600 by vw_gateway_remember_open() -
# see docs/DEPLOYMENT.md's own note on this). ProtectSystem=strict makes
# the whole filesystem read-only except paths explicitly listed below, so
# this entry is required for that file to be writable at all — without
# it the gateway would still start (this flag is optional, TASK-165's own
# opt-in framing) but every attempt to persist a remembered login would
# fail with EROFS. Remove both this line and --state-dir above together
# if you don't want the feature; don't add --state-dir without also
# adding this, or vice versa.
ReadWritePaths=/var/lib/vapourwault-gateway

# Allow larger file descriptor count for busy deployments (one FD per live
# browser session's vw_client_sess_t connection, plus one per in-flight
# HTTP request from nginx).
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
