<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_account"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_email" />

        <EditText
            android:id="@+id/emailField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />

        <Button
            android:id="@+id/saveEmailButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save_email" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_2fa" />

        <TextView
            android:id="@+id/twoFaStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/twoFaPasswordField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="@string/hint_current_password" />

        <Button
            android:id="@+id/toggle2faButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_notify_prefs" />

        <CheckBox
            android:id="@+id/notifyShareReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_notify_share_received" />

        <CheckBox
            android:id="@+id/notifyQuotaWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_notify_quota_warning" />

        <CheckBox
            android:id="@+id/notifyNewLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_notify_new_login" />

        <CheckBox
            android:id="@+id/notifyAccountSecurityChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_notify_account_security_change" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
