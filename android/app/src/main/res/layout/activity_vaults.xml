<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_vaults"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_existing_vaults" />

        <!-- TASK-244: fixed height, not wrap_content — same
             RecyclerView-in-ScrollView overflow hazard TASK-241 found and
             fixed in LoginActivity's profileList (confirmed here too via
             VaultsScaleTest: past ~one screenful, everything declared
             after this RecyclerView in the LinearLayout — the create-vault
             form, createVaultButton, statusText — is dropped from layout
             entirely, not merely scrolled off-screen). A fixed height
             makes this RecyclerView's own MeasureSpec EXACT instead of
             UNSPECIFIED, so it scrolls its own content internally
             regardless of how many vaults exist. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vaultList"
            android:layout_width="match_parent"
            android:layout_height="240dp" />

        <TextView
            android:id="@+id/emptyVaultsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_vaults"
            android:padding="16dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_create_vault" />

        <EditText
            android:id="@+id/newVaultFolderField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_new_vault_folder_name" />

        <EditText
            android:id="@+id/newVaultPassphraseField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="@string/hint_passphrase" />

        <EditText
            android:id="@+id/newVaultPassphraseConfirmField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="@string/hint_passphrase_confirm" />

        <Button
            android:id="@+id/createVaultButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_create_vault" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
