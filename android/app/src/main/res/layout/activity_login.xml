<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/savedProfilesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_saved_profiles"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- TASK-00241/TASK-00245: wrap_content, NOT a fixed height. A
             fixed height (240dp) turned out to still leave connectButton
             unreachable with 10 saved profiles in CI (LoginProfileScaleTest
             failing on PR #1) — RecyclerView's *default* nested-scrolling
             behavior competing with the outer ScrollView for the same
             gesture stream, not the MeasureSpec type itself, is the
             documented cause of "wrap_content inside ScrollView measures/
             renders wrong" for RecyclerView. The correct fix (see
             LoginActivity.kt's onCreate) is disabling the RecyclerView's
             own nested scrolling, which lets modern RecyclerView's
             auto-measure correctly size itself to its full content and
             hand all scrolling to the single outer ScrollView — no fixed
             height needed, and every view below it stays reachable
             regardless of profile count. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_add_profile"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/hostField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_host"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/portField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:text="@string/default_port" />

        <EditText
            android:id="@+id/userField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_username"
            android:inputType="text" />

        <EditText
            android:id="@+id/passField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/otpField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_otp"
            android:inputType="number"
            android:visibility="gone" />

        <Button
            android:id="@+id/importCaCertButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_import_ca_cert" />

        <TextView
            android:id="@+id/caCertStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_no_ca_cert"
            android:textSize="12sp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_connect" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
