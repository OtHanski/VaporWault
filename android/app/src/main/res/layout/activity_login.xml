<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/savedProfilesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_saved_profiles"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- TASK-00241: NOT wrap_content. A RecyclerView's wrap_content
             auto-measure inside a ScrollView only reliably works up to
             roughly one screenful of content — past that, the ScrollView's
             total scrollable height gets capped at approximately the
             RecyclerView's own height, and every sibling declared after it
             (the whole add-profile form, including connectButton) is
             dropped from layout entirely, not merely scrolled off-screen
             (confirmed via UiAutomator being unable to find connectButton
             at all, even off-screen, with 10 saved profiles present).
             A fixed height makes profileList's own MeasureSpec EXACT
             instead of UNSPECIFIED, so it scrolls its own content
             internally (nested scrolling, enabled by default) regardless
             of profile count, while every view below it stays reachable
             in the outer ScrollView no matter how many profiles exist. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="240dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_add_profile"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/hostField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_host"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/portField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:text="@string/default_port" />

        <EditText
            android:id="@+id/userField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_username"
            android:inputType="text" />

        <EditText
            android:id="@+id/passField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/otpField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_otp"
            android:inputType="number"
            android:visibility="gone" />

        <Button
            android:id="@+id/importCaCertButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_import_ca_cert" />

        <TextView
            android:id="@+id/caCertStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_no_ca_cert"
            android:textSize="12sp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_connect" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
